CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8082/'
session.cookieName = siakad_session

# Buat database siakad terlebih dahulu sebelum menjalankan migration.
database.default.hostname = localhost
database.default.database = siakad
database.default.username = root
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.port = 3306

# Untuk SQLite lokal, ganti DBDriver dan database di atas:
# database.default.DBDriver = SQLite3
# database.default.database = siakad.sqlite
# database.default.DBPrefix = ''

admin.username = admin
admin.nama = Administrator
# Wajib diisi sebelum menjalankan AdminSeeder, minimal 12 karakter.
admin.password = ''
