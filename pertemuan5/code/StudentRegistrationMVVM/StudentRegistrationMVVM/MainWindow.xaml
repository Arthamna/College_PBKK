<Window x:Class="StudentRegistrationMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration"
        Width="1120"
        Height="760"
        MinWidth="920"
        MinHeight="650"
        Background="#F4F7FB"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,18"
                Padding="20,16"
                Background="#0F4C81"
                CornerRadius="10">
            <StackPanel>
                <TextBlock Text="STUDENT REGISTRATION"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Margin="0,4,0,0"
                           Text="Pengelolaan data mahasiswa dengan pola MVVM"
                           Foreground="#D9EAF7"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="18"
                    Background="White"
                    CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,16"
                                   Text="FORM MAHASISWA"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="NIM"/>
                        <TextBox Margin="0,0,0,11"
                                 MaxLength="12"
                                 Text="{Binding FormMahasiswa.Nim, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Nama mahasiswa"/>
                        <TextBox Margin="0,0,0,11"
                                 MaxLength="100"
                                 Text="{Binding FormMahasiswa.Nama, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Program studi"/>
                        <ComboBox Margin="0,0,0,11"
                                  ItemsSource="{Binding DaftarProdi}"
                                  SelectedItem="{Binding FormMahasiswa.Prodi}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Jenis kelamin"/>
                        <ComboBox Margin="0,0,0,11"
                                  ItemsSource="{Binding DaftarJenisKelamin}"
                                  SelectedItem="{Binding FormMahasiswa.JenisKelamin}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Tanggal lahir"/>
                        <DatePicker Margin="0,0,0,11"
                                    SelectedDate="{Binding FormMahasiswa.TanggalLahir}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Alamat"/>
                        <TextBox Height="62"
                                 Margin="0,0,0,11"
                                 MaxLength="255"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding FormMahasiswa.Alamat, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Nomor telepon"/>
                        <TextBox Margin="0,0,0,16"
                                 MaxLength="15"
                                 Text="{Binding FormMahasiswa.NoTelepon, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Simpan / Update"
                                    Command="{Binding SaveCommand}"
                                    Background="#1677B8"
                                    Foreground="White"/>
                            <Button Grid.Column="2"
                                    Content="Reset"
                                    Command="{Binding ResetCommand}"
                                    Background="#E2E8F0"
                                    Foreground="#1E293B"/>
                        </Grid>

                        <TextBlock Margin="0,13,0,0"
                                   Text="{Binding StatusMessage}"
                                   Foreground="#B42318"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2"
                    Padding="18"
                    Background="White"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,16"
                               Text="DATA MAHASISWA"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 ToolTip="Cari berdasarkan NIM, nama, atau program studi"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2"
                                Width="80"
                                Content="Cari"
                                Command="{Binding SearchCommand}"
                                Background="#0F4C81"
                                Foreground="White"/>
                    </Grid>

                    <DataGrid Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              IsReadOnly="True"
                              ItemsSource="{Binding DaftarMahasiswa}"
                              SelectedItem="{Binding SelectedMahasiswa}"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="100" Header="NIM" Binding="{Binding Nim}"/>
                            <DataGridTextColumn Width="150" Header="Nama" Binding="{Binding Nama}"/>
                            <DataGridTextColumn Width="145" Header="Prodi" Binding="{Binding Prodi}"/>
                            <DataGridTextColumn Width="105" Header="Gender" Binding="{Binding JenisKelamin}"/>
                            <DataGridTextColumn Width="105"
                                                Header="Tanggal Lahir"
                                                Binding="{Binding TanggalLahir, StringFormat=dd-MM-yyyy}"/>
                            <DataGridTextColumn Width="180" Header="Alamat" Binding="{Binding Alamat}"/>
                            <DataGridTextColumn Width="120" Header="Telepon" Binding="{Binding NoTelepon}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#334155">
                            <Run Text="Jumlah mahasiswa: "/>
                            <Run Text="{Binding JumlahMahasiswa, Mode=OneWay}"/>
                        </TextBlock>
                        <Button Width="100"
                                HorizontalAlignment="Right"
                                Content="Hapus"
                                Command="{Binding DeleteCommand}"
                                Background="#C2413B"
                                Foreground="White"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
